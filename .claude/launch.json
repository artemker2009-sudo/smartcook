{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "recipe-ai-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--webpack"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "recipe-ai-prod",
